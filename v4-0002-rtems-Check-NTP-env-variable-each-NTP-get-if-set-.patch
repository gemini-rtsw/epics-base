diff --git a/modules/libcom/src/osi/os/RTEMS-posix/osdTime.cpp b/modules/libcom/src/osi/os/RTEMS-posix/osdTime.cpp
index 803bd72ac..0fa01f977 100644
--- a/modules/libcom/src/osi/os/RTEMS-posix/osdTime.cpp
+++ b/modules/libcom/src/osi/os/RTEMS-posix/osdTime.cpp
@@ -12,6 +12,7 @@
 //#define __BSD_VISIBLE 1
 #include <sys/types.h>
 #include <sys/socket.h>
+#include <arpa/inet.h>
 
 #define EPICS_EXPOSE_LIBCOM_MONOTONIC_PRIVATE
 #include <epicsStdio.h>
@@ -21,21 +22,78 @@
 #include <sys/types.h>
 #include <sys/socket.h>
 #include <netinet/in.h>
+#include "envDefs.h"
 #include "epicsTime.h"
 #include "osdTime.h"
 #include "osiNTPTime.h"
 #include "osiClockTime.h"
 #include "generalTimeSup.h"
 
+#include <rtems/rtems_bsdnet.h>
 #include <rtems/rtems_bsdnet_internal.h>
+#include <rtems/bsdnet/servers.h>
+
 extern "C" {
 
 extern rtems_interval rtemsTicksPerSecond;
-int rtems_bsdnet_get_ntp(int, int(*)(), struct timespec *);
 static int ntpSocket = -1;
+static struct in_addr envEPICS_TS_NTP_INET;
+
+static bool addressCompare(const struct in_addr* a, const struct in_addr* b) {
+    return a->s_addr == b->s_addr;
+}
+
+/*
+ * BOOTP will set an entry. Insert the ENV variable into the table as
+ * the first entry so it is used.
+ */
+static void checkEnv(void) {
+    #define NUMOF(_s) (int) (sizeof(_s) / sizeof(_s[0]))
+    const char* cp = getenv("EPICS_TS_NTP_INET");
+    int index;
+    for (index = 0; index < rtems_bsdnet_ntpserver_count; ++index) {
+        if (addressCompare(&rtems_bsdnet_ntpserver[index], &envEPICS_TS_NTP_INET)) {
+            break;
+        }
+    }
+    if (index == rtems_bsdnet_ntpserver_count) {
+        if (cp != NULL) {
+            if (rtems_bsdnet_ntpserver_count < NUMOF(rtems_bsdnet_config.name_server)) {
+                /* insert to start of table */
+                rtems_bsdnet_ntpserver_count++;
+                for (index = 0; index < rtems_bsdnet_ntpserver_count; ++index) {
+                    rtems_bsdnet_ntpserver[index + 1] = rtems_bsdnet_ntpserver[index];
+                }
+                index = 0;
+            } else {
+                index = -1;
+            }
+        } else {
+            /* ignore */
+            index = -1;
+        }
+    } else {
+        if (cp == NULL) {
+            /* remove and compact */
+            while (index < rtems_bsdnet_ntpserver_count - 1) {
+                rtems_bsdnet_ntpserver[index] = rtems_bsdnet_ntpserver[index + 1];
+                ++index;
+            }
+            --rtems_bsdnet_ntpserver_count;
+            rtems_bsdnet_ntpserver[rtems_bsdnet_ntpserver_count] = { 0 };
+            index = -1;
+        }
+    }
+    if (index >= 0 && cp != NULL) {
+        envEPICS_TS_NTP_INET.s_addr = inet_addr (cp);
+        rtems_bsdnet_ntpserver[index] = envEPICS_TS_NTP_INET;
+    }
+}
 
 void osdTimeRegister(void)
 {
+    checkEnv();
+
     /* Init NTP first so it can be used to sync ClockTime */
     NTPTime_Init(100);
     ClockTime_Init(CLOCKTIME_SYNC);
@@ -51,6 +109,8 @@ int osdNTPGet(struct timespec *ts)
     if (ntpSocket < 0)
         return -1;
 
+    checkEnv();
+
     /* rtems_bsdnet_get_ntp() will send an NTP request, then
      * call recvfrom() exactly once to process the expected reply.
      * Any leftovers in the socket buffer (ie. duplicates of
@@ -83,6 +143,8 @@ void osdNTPInit(void)
 {
     struct sockaddr_in myAddr;
 
+    checkEnv();
+
     ntpSocket = socket (AF_INET, SOCK_DGRAM, 0);
     if (ntpSocket < 0) {
         printf("osdNTPInit() Can't create socket: %s\n", strerror (errno));
@@ -101,6 +163,14 @@ void osdNTPInit(void)
 
 void osdNTPReport(void)
 {
+    if (rtems_bsdnet_ntpserver_count != 0) {
+        printf("NTP Servers = %d\n", rtems_bsdnet_ntpserver_count);
+        int i;
+        for (i = 0; i < rtems_bsdnet_ntpserver_count; ++i) {
+            uint8_t* p = (uint8_t*) &rtems_bsdnet_ntpserver[i];
+            printf(" %i - %u.%u.%u.%u\n", i, p[0], p[1], p[2], p[3]);
+        }
+    }
 }
 
 int osdTickGet(void)
@@ -154,6 +224,7 @@ double rtemsTicksPerSecond_double, rtemsTicksPerTwoSeconds_double;
  * standard time providers at static constructor time; in this
  * case the network is available already.
  */
+extern "C" int printk(const char* fmt);
 static int staticTimeRegister(void)
 {
     rtemsTicksPerSecond = rtems_clock_get_ticks_per_second();
